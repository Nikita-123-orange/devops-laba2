pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS = credentials('docker')
        LC_ALL = "en_US.UTF-8"
        LANG    = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
        // Несекретные параметры БД
        POSTGRESQL_HOST = "db"
        POSTGRESQL_PORT = "5432"
        POSTGRESQL_DB   = "mydb"
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Clone repository (for compose file)') {
            steps {
                // Если директория уже есть – делаем pull, иначе clone
                bat '''
                    if exist devops-laba2 (
                        cd devops-laba2 && git pull origin main
                    ) else (
                        git clone -b main https://github.com/Nikita-123-orange/devops-laba2.git
                    )
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                bat 'docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
            }
        }

        stage('Pull latest image') {
            steps {
                bat 'docker pull nikita123orange/devops-laba2:latest'
            }
        }

        stage('Stop and remove old containers') {
            steps {
                dir('devops-laba2') {
                    // Останавливаем и удаляем старые контейнеры, но НЕ удаляем том с данными БД
                    bat 'docker-compose down'
                }
            }
        }

        stage('Run database and web containers') {
            steps {
                script {
                    dir('devops-laba2') {
                        // Создаём временный .env файл с секретными переменными
                        withCredentials([
                            string(credentialsId: 'postgres-user', variable: 'POSTGRESQL_USER'),
                            string(credentialsId: 'postgres-password', variable: 'POSTGRESQL_PASSWORD')
                        ]) {
                            // Записываем переменные в .env (будет проигнорирован .gitignore)
                            bat """
                                echo POSTGRESQL_USER=${POSTGRESQL_USER} > .env
                                echo POSTGRESQL_PASSWORD=${POSTGRESQL_PASSWORD} >> .env
                                echo POSTGRESQL_HOST=${POSTGRESQL_HOST} >> .env
                                echo POSTGRESQL_PORT=${POSTGRESQL_PORT} >> .env
                                echo POSTGRESQL_DB=${POSTGRESQL_DB} >> .env
                            """
                            // Запускаем контейнеры – образ для web уже скачан, пересборки не будет
                            bat 'docker-compose up -d'
                        }
                    }
                }
            }
        }

        stage('Verify containers are running') {
            steps {
                dir('devops-laba2') {
                    bat 'docker-compose ps'
                }
            }
        }
    }

    post {
        always {
            node('windows') {
                bat 'docker logout'
                // Опционально: удаляем .env файл (чтобы не хранить пароли на диске)
                bat 'if exist devops-laba2\\.env del devops-laba2\\.env'
            }
        }
    }
}